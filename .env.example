# GlobeTrotter -- local environment configuration
# ------------------------------------------------
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in the values for YOUR machine
# 3. `.env` is git-ignored, so your real password never gets committed.
#
# Any variable already set in your real OS environment overrides the file.

# --- Django ---
# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True

# --- PostgreSQL ---
GLOBETROTTER_DB_NAME=globetrotter
GLOBETROTTER_DB_USER=postgres
GLOBETROTTER_DB_PASSWORD=your-postgres-password-here
GLOBETROTTER_DB_HOST=127.0.0.1
GLOBETROTTER_DB_PORT=5432
